@page "/"
@using LearnSql.Core.Services.Navigation

<PageTitle>@LApp["ProductName"]</PageTitle>

<div class="home">
    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["HomeHeading"]</MudText>
    <MudText Class="mb-6">@L["HomePurpose"]</MudText>

    <div class="home-cards">
        <MudPaper Elevation="2" Class="pa-4 home-card">
            <MudText Class="text-muted" Typo="Typo.overline">@L["PlaygroundOverline"]</MudText>
            <MudText Typo="Typo.h6" HtmlTag="h2">@L["PlaygroundHeading"]</MudText>
            <MudText Typo="Typo.body2" Class="home-card-text">@L["PlaygroundText"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="playground"
                       StartIcon="@Icons.Material.Filled.Code">
                @L["OpenPlayground"]
            </MudButton>
        </MudPaper>

        <MudPaper Elevation="2" Class="pa-4 home-card">
            <MudText Class="text-muted" Typo="Typo.overline">@L["CurrentScenario"]</MudText>
            <MudText Typo="Typo.h6" HtmlTag="h2">@Texts.GetTitle(Session.Scenario)</MudText>
            <MudText Typo="Typo.body2" Class="home-card-text">@Texts.GetDescription(Session.Scenario)</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ScenarioRoutes.Path(Session.Scenario.Id)"
                       StartIcon="@Icons.Material.Filled.School">
                @L["OpenScenario"]
            </MudButton>
        </MudPaper>
    </div>

    @if (!Texts.CoversCurrentLanguage)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6">@L["ContentLanguageNotice"]</MudAlert>
    }

    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
        <MudText Typo="Typo.subtitle2">@L["EngineNoteTitle"]</MudText>
        <MudText Typo="Typo.body2">@L["EngineNoteText"]</MudText>
    </MudAlert>
</div>

@page "/counter"
@using System.Data
@using LearnSql.Sql
@using LearnSql.Sql.Exceptions
@using LearnSql.Sql.Extensions
@using LearnSql.Sql.Generated
@using Microsoft.SqlServer.TransactSql.ScriptDom
@using Environment = System.Environment
@using Range = System.Range

@inject DatabaseProvider Database;

<PageTitle>Playground</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Playground</MudText>


<MudSplitPanel Class="mud-width-full mud-height-full" Style="height: calc(100vh - 160px);" FirstPanelInitialSize="300" ResetOnDoubleClick="true" Transparent="true" MinPanelSize="300">
    <FirstPanel>
        <MudPaper Height="100%">
            @* Links: Editor *@
        </MudPaper>
    </FirstPanel>
    <SecondPanel>
        <MudSplitPanel Class="mud-width-full mud-height-full" Elevation="1" Horizontal="true" MinPanelSize="200">
            <FirstPanel>
                <MudPaper Height="100%">
                    <MudPaper Height="calc(100% - 48px)" Elevation="0">
                        <StandaloneCodeEditor @ref="_editor" Id="sql-editor" ConstructionOptions="Options" OnMouseDown="OnMouseDown"/>
                    </MudPaper>
                    <MudToolBar Dense="true">
                        <MudButton Class="mr-5" Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunSql">
                            Run
                        </MudButton>
                        
                        <MudMenu Label="Templates" Variant="Variant.Filled" AlignItems="AlignItems.End">
                            <MudMenuItem OnClick="SelectAllTablesTemplate" EndIcon="@Icons.Material.Outlined.LooksOne" Label="Select all tables" />
                            @* <MudFabMenuItem EndIcon="@Icons.Material.Outlined.LooksTwo" Label="Two" Color="Color.Tertiary" Style="color: rgb(33, 33, 33);"/> *@
                            @* <MudFabMenuItem EndIcon="@Icons.Material.Outlined.Looks3" Label="Three" Color="Color.Tertiary" Style="color: rgb(33, 33, 33);"/> *@
                        </MudMenu>
                        @* <MudSelect Color="Color.Default" Variant="Variant.Filled" *@
                        @*            StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ClearSql"> *@
                        @*     See all tables *@
                        @* </MudSelect> *@
                        <MudButton Color="Color.Default" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ClearSql">
                            Clear
                        </MudButton>
                    </MudToolBar>
                </MudPaper>
            </FirstPanel>
            <SecondPanel>
                <MudPaper Height="100%" Class="pa-2" Style="overflow: auto">
                    @if (_lastValidationErrors.Any())
                    {
                        @* <MudGrid Style="padding: 5px;"> *@
                        <MudText>The written SQL statement could not be validated:</MudText>
                        @foreach (ParseError parseError in _lastValidationErrors)
                        {
                            <MudText>@parseError.ToSummary()</MudText>
                        }
                        // </MudGrid>
                    }
                    else if (_lastExecutionError is not null)
                    {
                        @* <MudGrid Style="padding: 5px;"> *@
                        <MudText Color="Color.Error">@_lastExecutionError.Message</MudText>
                        // </MudGrid>
                    }
                    else if (_lastResult is not null)
                    {
                        <MudSimpleTable Dense="true" Hover="true" Striped="true">
                            <thead>
                            <tr>
                                @foreach (DataColumn column in _lastResult.Columns)
                                {
                                    <th>@column.ColumnName</th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (DataRow row in _lastResult.Rows)
                            {
                                <tr>
                                    @foreach (var value in row.ItemArray)
                                    {
                                        <td>@(value is DBNull ? "NULL" : value)</td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
                </SecondPanel>
        </MudSplitPanel>
    </SecondPanel>
</MudSplitPanel>
@* <MudGrid Spacing="2"> *@
@* *@
@*     <MudItem xs="12" md="6"> *@
@*     </MudItem> *@
@* </MudGrid> *@

@code {
    IList<ParseError> _lastValidationErrors = new List<ParseError>();
    TranslatedException? _lastExecutionError = null;
    DataTable? _lastResult = null;
    
    private StandaloneCodeEditor _editor = default!;

    private StandaloneEditorConstructionOptions Options(StandaloneCodeEditor editor) =>
        new StandaloneEditorConstructionOptions
        {
            Language = "sql", Theme = "vs-dark", AutomaticLayout = true, Value = "Select * from sao.customers"
        };
    
    private async Task OnMouseDown(EditorMouseEvent e)
    {
        if (!(e.Event.CtrlKey || e.Event.MetaKey) || e.Target.Position is null) return;
        TextModel model = await _editor.GetModel();
        WordAtPosition? word = await model.GetWordAtPosition(e.Target.Position);
        
        if (word is not null)
            Console.WriteLine(word);
        // await OnKeywordClicked(word.Word); // z.B. Erklärung zu "JOIN" öffnen
    }

    // TODO: Validate if a schema was supplied and if it was valid later. Support a mode where schema doesnt matter (sqlite supports this)
    private async Task SelectAllTablesTemplate()
    {
        // TODO: INFORMATION_SCHEMA.
        await _editor.SetValue("SELECT *\nFROM TABLES\nWHERE TABLE_TYPE='Base Table'");
    }
    // TODO: Affected rows
    // TODO: only execute selection

    private async Task RunSql()
    {
        _lastValidationErrors.Clear();
        _lastExecutionError = null;

        Selection selection = await _editor.GetSelection();
        TextModel model = await _editor.GetModel();

        string value = selection.StartLineNumber == selection.EndLineNumber && selection.StartColumn == selection.EndColumn
            ? await model.GetValue(EndOfLinePreference.TextDefined, true)
            : await model.GetValueInRange(selection, EndOfLinePreference.TextDefined);
        
        _lastValidationErrors = MsSqlValidator.Validate(value, SqlVersion.Sql180);
        if (!_lastValidationErrors.Any())
        {
            Console.WriteLine("SQL statement validated.");
            try
            {
                _lastResult = await Database.RunCommand(value);
            }
            catch (TranslatedException translatedException)
            {
                _lastExecutionError = translatedException;
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                throw;
            }
        }
        else
        {
            Console.WriteLine("SQL statement had errors:");
            foreach (ParseError parseError in _lastValidationErrors)
            {
                Console.WriteLine(parseError.ToSummary());
            }
        }
    }

    private async Task ClearSql()
    {
        await _editor.SetValue("");
    }

    protected override async Task OnInitializedAsync()
    {
        await Database.ProvisionScenario("playground");
    }
}

@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="Theme.IsDark"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<button type="button" class="skip-link" @onclick="FocusMainAsync">@L["SkipToContent"]</button>

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="@L["ToggleNavigation"]" OnClick="ToggleDrawer"/>
        <MudLink Href="" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None" Class="app-title">
            @L["ProductName"]
        </MudLink>
        <ActiveScenarioLink/>
        <DatabaseResetButton/>
        <MudSpacer/>
        <LanguageSwitcher/>
        <ThemeToggle/>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent>
        <main id="main-content" class="app-main" tabindex="-1" @ref="_main">
            <PageErrorBoundary @ref="_boundary">
                <AppStateGate>@Body</AppStateGate>
            </PageErrorBoundary>
        </main>
    </MudMainContent>
</MudLayout>

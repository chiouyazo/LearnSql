<div class="loading-panel" role="status" aria-live="polite">
    <MudPaper Elevation="2" Class="loading-card pa-6">
        <MudText Typo="Typo.h6" Class="mb-1">@Title</MudText>
        <MudText Typo="Typo.body2" Class="text-muted mb-4">@PhaseText</MudText>
        @if (Progress is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@PhaseText"/>
        }
        else
        {
            <MudProgressLinear Value="@Percent" Max="100" Color="Color.Primary" aria-label="@PhaseText"/>
            <MudText Typo="Typo.caption" Class="text-muted mt-1">
                @L["LoadingStep", Progress.Step, Progress.TotalSteps]
            </MudText>
        }
    </MudPaper>
</div>

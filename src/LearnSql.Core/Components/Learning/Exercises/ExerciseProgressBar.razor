<progress class="exercise-progress" max="@Max" value="@Value" aria-label="@Label"></progress>

@code {
    [Parameter, EditorRequired]
    public int Value { get; set; }

    [Parameter, EditorRequired]
    public int Max { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;
}

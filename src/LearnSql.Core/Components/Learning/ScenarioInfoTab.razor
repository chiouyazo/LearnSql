@using LearnSql.Core.Components.Learning.Guided
@implements IDisposable

@{
    ScenarioDefinition scenario = Texts.Localize(Session.Scenario);
}

<section class="scenario-info" aria-labelledby="scenario-info-title">
    <GuidedNotices/>

    @if (Coordinator.Machine is not null)
    {
        <div class="scenario-info-player">
            <GuidedPlayer/>
        </div>
    }

    <MudText Typo="Typo.h6" HtmlTag="h2" id="scenario-info-title">@scenario.Title</MudText>
    <MudText Typo="Typo.body2" Class="scenario-info-text mb-4">@scenario.Description</MudText>

    @if (Coordinator.Machine is null && scenario.GuidedScenarios.Count > 0)
    {
        <div class="scenario-info-guided">
            <GuidedExampleList Definitions="scenario.GuidedScenarios" Disabled="Coordinator.IsBusy"
                               OnStart="StartAsync"/>
        </div>
    }

    <MudText Typo="Typo.overline" HtmlTag="h3" Class="text-muted">@L["InfoDatabaseTitle"]</MudText>
    @if (_schemaFailed)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-4">@L["InfoSchemaFailed"]</MudAlert>
    }
    else
    {
        <dl class="scenario-info-facts mb-4">
            <div>
                <dt>@L["LabelTables"]</dt>
                <dd>@(_tables?.ToString() ?? "-")</dd>
            </div>
            <div>
                <dt>@L["LabelViews"]</dt>
                <dd>@(_views?.ToString() ?? "-")</dd>
            </div>
        </dl>
    }

    <MudText Typo="Typo.overline" HtmlTag="h3" Class="text-muted">@L["InfoLearningTitle"]</MudText>
    @if (scenario.Exercises.Count == 0 && scenario.GuidedScenarios.Count == 0)
    {
        <MudText Typo="Typo.body2">@L["InfoNoLearning"]</MudText>
    }
    else
    {
        <dl class="scenario-info-facts mb-2">
            <div>
                <dt>@L["LabelExercises"]</dt>
                <dd>@scenario.Exercises.Count</dd>
            </div>
            <div>
                <dt>@L["LabelGuided"]</dt>
                <dd>@scenario.GuidedScenarios.Count</dd>
            </div>
        </dl>
        @if (scenario.Exercises.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="text-muted">@L["InfoLearningHint"]</MudText>
        }
    }
</section>
